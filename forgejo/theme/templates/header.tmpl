{{/* Pre-paint root redirect + profile styles. The edge rule is the primary
     redirect; this covers direct origin / tailnet access. */}}
<script>
  (function () {
    try {
      if (location.pathname === "/" && !location.search) {
        var target = "{{if .SignedUser}}/{{.SignedUser.Name}}{{else}}/taf{{end}}?tab=repositories";
        location.replace(target);
      }
    } catch (e) {}
  })();
</script>
<link rel="stylesheet" href="{{AssetUrlPrefix}}/themes/profile.css?v=4">
