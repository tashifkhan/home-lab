{
  "_comment": "Custom mappings for home-lab Nextcloud. After edits run: occ maintenance:mimetype:update-db && occ maintenance:mimetype:update-js",
  "avif": ["image/avif"],
  "ipynb": ["application/x-ipynb+json"],
  "icns": ["image/icns"],
  "gdoc": ["application/vnd.google-apps.document"],
  "gslides": ["application/vnd.google-apps.presentation"],
  "gsheet": ["application/vnd.google-apps.spreadsheet"],
  "gdraw": ["application/vnd.google-apps.drawing"],
  "gform": ["application/vnd.google-apps.form"],
  "cnote": ["application/x-cnote"],
  "woff2": ["font/woff2"],
  "mjs": ["text/javascript", "application/javascript"],
  "cjs": ["text/javascript", "application/javascript"],
  "ts": ["application/typescript", "text/plain"],
  "tsx": ["application/typescript", "text/plain"],
  "cts": ["application/typescript", "text/plain"],
  "mts": ["application/typescript", "text/plain"],
  "pyc": ["application/x-python-bytecode"],
  "pkl": ["application/octet-stream"],
  "pickle": ["application/octet-stream"],
  "dwg": ["image/vnd.dwg"],
  "dmg": ["application/x-apple-diskimage"],
  "prisma": ["text/plain"],
  "toml": ["application/toml", "text/plain"],
  "db": ["application/x-sqlite3"],
  "sqlite": ["application/x-sqlite3"],
  "sqlite3": ["application/x-sqlite3"],
  "lnk": ["application/x-ms-shortcut"],
  "wasm": ["application/wasm"],
  "pyi": ["text/x-python"],
  "kt": ["text/x-kotlin"],
  "swift": ["text/x-swift"],
  "proto": ["text/x-protobuf"]
}
