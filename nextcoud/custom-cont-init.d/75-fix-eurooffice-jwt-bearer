#!/usr/bin/with-contenv bash
set -euo pipefail

# Euro-Office may send AuthorizationJwt either as a raw JWT or as
# "Bearer <jwt>". Upstream CallbackController always strips strlen("Bearer ")
# bytes, which corrupts a raw token and breaks /apps/eurooffice/empty (500 /
# Malformed UTF-8). Only strip the prefix when it is present.
#
# Also harden getDefaultFormats(): json_decode can return null, but the method
# is typed to return array, which crashes editor config with a TypeError.

php /dev/stdin <<'PHP'
<?php
$callback = '/app/www/public/apps/eurooffice/lib/Controller/CallbackController.php';
if (!is_file($callback)) {
    echo "Euro-Office JWT Bearer patch skipped (missing CallbackController)\n";
    exit(0);
}

$src = file_get_contents($callback);
if (str_contains($src, 'str_starts_with($header, "Bearer ")')) {
    echo "Euro-Office JWT Bearer patch already applied\n";
} else {
    $old = '$header = substr((string) $header, strlen("Bearer "));';
    $new = '$header = (string) $header;' . "\n"
        . '            if (str_starts_with($header, "Bearer ")) {' . "\n"
        . '                $header = substr($header, strlen("Bearer "));' . "\n"
        . '            }';
    $count = 0;
    $src = str_replace($old, $new, $src, $count);
    if ($count !== 3) {
        fwrite(STDERR, "Euro-Office JWT Bearer patch skipped (expected 3 sites, found $count)\n");
        exit(1);
    }
    if (file_put_contents($callback, $src) === false) {
        fwrite(STDERR, "Failed to write Euro-Office JWT Bearer patch\n");
        exit(1);
    }
    echo "Applied Euro-Office JWT Bearer patch ($count sites)\n";
}

$appConfig = '/app/www/public/apps/eurooffice/lib/AppConfig.php';
if (!is_file($appConfig)) {
    echo "Euro-Office getDefaultFormats patch skipped (missing AppConfig)\n";
    exit(0);
}

$src = file_get_contents($appConfig);
if (str_contains($src, 'is_array($decoded) ? $decoded : []')) {
    echo "Euro-Office getDefaultFormats patch already applied\n";
    exit(0);
}

$old = "        return json_decode(\$value, true);\n    }\n\n    /**\n     * Save an array of formats that is opened for editing";
$new = "        \$decoded = json_decode(\$value, true);\n        return is_array(\$decoded) ? \$decoded : [];\n    }\n\n    /**\n     * Save an array of formats that is opened for editing";
$count = 0;
$src = str_replace($old, $new, $src, $count);
if ($count !== 1) {
    fwrite(STDERR, "Euro-Office getDefaultFormats patch skipped (unexpected source)\n");
    exit(1);
}
if (file_put_contents($appConfig, $src) === false) {
    fwrite(STDERR, "Failed to write Euro-Office getDefaultFormats patch\n");
    exit(1);
}
echo "Applied Euro-Office getDefaultFormats null-safety patch\n";
PHP
