DASHBOARD_PASSWORD=your-password-here
JWT_SECRET=generate-a-long-random-string-here

# Tailscale OAuth (create at https://login.tailscale.com/admin/settings/oauth)
# Scope required: devices:read
TAILSCALE_CLIENT_ID=
TAILSCALE_CLIENT_SECRET=
TAILSCALE_TAILNET=-

# Host IPs used for local links
HOME_SERVER_TS_IP=100.x.y.z
HOME_SERVER_LAN_IP=192.168.x.y
MAC_AIR_TS_IP=100.x.y.z

# Tailscale IPs running agents/battery_agent.py (comma-separated).
# Defaults to MAC_AIR_TS_IP. The home server's own battery comes from sysfs.
# BATTERY_AGENT_IPS=100.x.y.z
